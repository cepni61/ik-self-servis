# --- Uygulama ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173

# --- Veritabani ---
# Dev: SQLite. Kurumsal ortamda PostgreSQL / SQL Server connection string.
# NOT: SQLite icin goreli yol prisma/schema.prisma dizinine gore cozulur.
# Yani "file:./dev.db" -> server/prisma/dev.db
DATABASE_URL="file:./dev.db"

# --- Kimlik dogrulama ---
# local = seed edilmis kullanicilar, oidc = Entra ID (ileride)
AUTH_PROVIDER=local
# PRODUCTION'DA MUTLAKA DEGISTIRIN
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=8h
JWT_ISSUER=hr-self-service
# Dev kolayligi: parola sormadan kullanici secerek giris. Production'da otomatik kapali.
ALLOW_DEV_LOGIN=true

# --- Dosya ---
STORAGE_DIR=./storage
ATTACHMENT_MAX_SIZE_MB=20

# --- SLA ---
SLA_JOB_INTERVAL_MINUTES=15
