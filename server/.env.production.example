# =========================================================================
# PRODUCTION / TEST SUNUCUSU ORTAM DOSYASI
#
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun.
# Uygulama, guvensiz konfigurasyonla ACILMAZ (assertProductionSafety).
# =========================================================================

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# --- Veritabani ---
# SQLite (kucuk ekip / test): goreli yol prisma/ dizinine gore cozulur.
DATABASE_URL="file:./prod.db"
# PostgreSQL ornegi:
# DATABASE_URL="postgresql://kullanici:parola@sunucu:5432/hrss?schema=public"

# --- Kimlik dogrulama ---
# ZORUNLU: en az 32 karakter, rastgele. Uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_ISSUER=hr-self-service

# Kurumsal ortamda 'oidc' (Entra ID) yapilacak. Simdilik yerel parola.
AUTH_PROVIDER=local

# Parolasiz giris. Production'da KULLANILAMAZ; tanimliysa uygulama acilmaz.
ALLOW_DEV_LOGIN=false

# --- Web arayuzu ---
# API ile ayni porttan servis edilir. Bos ise <repo>/web/dist kullanilir.
# WEB_DIST_DIR=/app/web/dist

# Ayni porttan servis edildiginde CORS'a gerek yoktur. Frontend ayri bir
# adreste barinacaksa o adresi buraya yazin (virgulle ayirin).
# CORS_ORIGINS=https://ik-test.sirket.local

# --- Dosya yukleme ---
# Kalici bir dizin olmali (container'da volume baglayin).
STORAGE_DIR=/var/lib/hrss/storage
ATTACHMENT_MAX_SIZE_MB=20

# --- SLA ---
SLA_JOB_INTERVAL_MINUTES=15
